rules_version = '2';

// Firestore security rules for wenlance_next_js.
//
// Data model: every record lives in a private per-user tree
//   users/{userId}/<collection>/<documentId>
// where <collection> is one of: expenses, projects, sales, savings,
// savingsUtilizations, tasks.
//
// The client always reads and writes with auth.currentUser.uid as {userId}
// (see lib/repositories/*Repository.ts), so ownership is enforced by path.
// Anything not matched below is denied by default.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The user's document and every subcollection under it belong to that user.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{collection}/{documentId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
